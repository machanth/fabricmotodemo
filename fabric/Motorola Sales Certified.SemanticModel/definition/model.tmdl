model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["DatabaseQuery"]

	ref table 'Fact Sales'
	ref table Customer
	ref table Product
	ref table Segment
	ref table 'Customer Segment Bridge'
	ref table 'Order Date'
	ref table 'Ship Date'

	ref role 'North America'
	ref role Europe

	ref cultureInfo en-US

	expression DatabaseQuery =
			let
			    Source = Sql.Database(
			        "{{LAKEHOUSE_SQL_ENDPOINT}}",
			        "{{LAKEHOUSE_SQL_DATABASE}}",
			        [CreateNavigationProperties = false]
			    )
			in
			    Source
		lineageTag: b2d19ee6-1e75-44f4-8aba-5fde70df5a8e

		annotation PBI_NavigationStepName = Navigation
