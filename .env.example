# Microsoft Entra application authentication (never commit real values)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# Target Fabric resources
FABRIC_CAPACITY_ID=00000000-0000-0000-0000-000000000000
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_WORKSPACE_NAME=moto-fabric-poc

# External object-storage shortcut. Use one source type and matching fields.
SHORTCUT_SOURCE_TYPE=AdlsGen2
SHORTCUT_CONNECTION_ID=00000000-0000-0000-0000-000000000000
SHORTCUT_LOCATION=https://example.dfs.core.windows.net
SHORTCUT_SUBPATH=/motosc/customer-domain
