{
  "$schema": "./data-agent-config.schema.json",
  "displayName": "Motorola Sales Agent",
  "description": "Read-only POC agent grounded only in the certified synthetic sales model.",
  "sourceBinding": {
    "type": "SemanticModel",
    "workspaceId": "${FABRIC_WORKSPACE_ID}",
    "displayName": "Motorola Sales Certified",
    "itemId": "${SEMANTIC_MODEL_ITEM_ID}"
  },
  "approvedTables": [
    "Fact Sales",
    "Customer",
    "Product",
    "Segment",
    "Order Date",
    "Ship Date"
  ],
  "instructionsFile": "instructions.md",
  "testCasesFile": "test-cases.json",
  "deployment": {
    "configurationApiStatus": "preview",
    "publishApiStatus": "preview",
    "requireHumanValidationBeforePublish": true
  }
}
